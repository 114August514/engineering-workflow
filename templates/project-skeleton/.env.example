# 全部键名 + 说明 + 示例格式。**不许有任何真实值。**
# 复制成 .env 后填。.env 已在 .gitignore 里。
#
# 规则：程序启动时必须校验所有必需项，缺一个就退出并明确说缺哪个 ——
# 不要让它跑到第一个请求才失败。

# 运行环境：development | staging | production
APP_ENV=development

# 服务监听端口
PORT=8080

# 数据库连接串
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 会话/令牌签名密钥（生产环境必须是随机生成的长串，不要用示例值）
SECRET_KEY=
